# ==============================================================================
# Agentic Systems Lab: Environment Configuration
# Use local/free providers (Ollama, Groq, Google Gemini) to practice at $0 cost.
# ==============================================================================

# 1. Local Inference (Ollama / vLLM / SGLang) - 100% Free & Offline
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# 2. Free Cloud API Tiers
# Google AI Studio (Free Tier: generous RPM for Gemini 2.0 Flash)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=

# Groq Cloud (Free Tier: ultra-fast Llama 3.3 70B & DeepSeek R1)
# Get key: https://console.groq.com/
GROQ_API_KEY=

# OpenRouter (Supports free models via ':free' suffix)
# Get key: https://openrouter.ai/
OPENROUTER_API_KEY=

# 3. Optional Frontier APIs (Paid)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 4. Observability (Self-hostable via Docker or Free Cloud)
# Langfuse: https://langfuse.com/
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Phoenix (Arize): http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

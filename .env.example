# ==============================================================================
# Agentic Systems Lab: Zero-Cost Environment Configuration
# Strictly free-tier & local providers. No paid subscriptions needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq Cloud (Free Tier: Ultra-fast tool-calling on Llama 3.3 70B)
# Get free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Google AI Studio (Free Tier: Gemini 2.0 Flash with native function calling)
# Get free key at: https://aistudio.google.com/app/apikey
# Note: Gemini supports the standard OpenAI format via the endpoint below
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. OpenRouter (Free models tagged with ':free')
# Get free key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# 4. Local Ollama (100% Free, Offline, Unlimited Tokens)
# Install from: https://ollama.ai
# Recommended models: 'ollama run qwen2.5-coder:7b' or 'ollama run llama3.1:8b'
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# 5. Local Observability (Self-hostable via Docker Compose at $0)
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
